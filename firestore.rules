rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnerUser() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'joandelvallearg@gmail.com';
    }

    function isValidTrack(data) {
      return data.keys().hasAll([
          'ownerId', 'youtubeId', 'youtubeUrl', 'title', 'artist',
          'country', 'countryCode', 'language', 'languageCode',
          'genre', 'thumbnailUrl', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'youtubeId', 'youtubeUrl', 'title', 'artist',
          'country', 'countryCode', 'language', 'languageCode',
          'genre', 'isRemix', 'curatorNote', 'thumbnailUrl', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string
        && data.ownerId.size() > 0 && data.ownerId.size() <= 128
        && data.ownerId == request.auth.uid
        && data.youtubeId is string
        && data.youtubeId.size() >= 5 && data.youtubeId.size() <= 32
        && data.youtubeId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.youtubeUrl is string
        && data.youtubeUrl.size() >= 10 && data.youtubeUrl.size() <= 300
        && data.title is string
        && data.title.size() >= 1 && data.title.size() <= 200
        && data.artist is string
        && data.artist.size() >= 1 && data.artist.size() <= 150
        && data.country is string
        && data.country.size() >= 1 && data.country.size() <= 100
        && data.countryCode is string
        && data.countryCode.size() >= 2 && data.countryCode.size() <= 7
        && data.countryCode.matches('^[A-Z]{2,3}(,[A-Z]{2,3})?$')
        && data.language is string
        && data.language.size() >= 1 && data.language.size() <= 80
        && data.languageCode is string
        && data.languageCode.size() >= 2 && data.languageCode.size() <= 22
        && data.languageCode.matches('^[a-zA-Z\\-]+(,[a-zA-Z\\-]+)?$')
        && data.genre is string
        && data.genre.size() >= 1 && data.genre.size() <= 80
        && (!data.keys().hasAny(['isRemix']) || data.isRemix is bool)
        && (!data.keys().hasAny(['curatorNote']) || (data.curatorNote is string && data.curatorNote.size() <= 400))
        && data.thumbnailUrl is string
        && data.thumbnailUrl.size() >= 10 && data.thumbnailUrl.size() <= 300
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPhoto(data) {
      return data.keys().hasAll([
          'ownerId', 'imageData', 'caption', 'order', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'imageData', 'caption', 'order', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string
        && data.ownerId.size() > 0 && data.ownerId.size() <= 128
        && data.ownerId == request.auth.uid
        && data.imageData is string
        && data.imageData.size() >= 10 && data.imageData.size() <= 700000
        && data.caption is string
        && data.caption.size() <= 200
        && data.order is number
        && data.order >= 0 && data.order <= 10000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSiteConfig(data) {
      return data.keys().hasAll([
          'ownerId', 'hiddenSeedTrackIds', 'hiddenSeedPhotoIds', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'hiddenSeedTrackIds', 'hiddenSeedPhotoIds', 'updatedAt'
        ])
        && data.ownerId is string
        && data.ownerId.size() > 0 && data.ownerId.size() <= 128
        && data.ownerId == request.auth.uid
        && data.hiddenSeedTrackIds is list
        && data.hiddenSeedTrackIds.size() <= 20
        && (data.hiddenSeedTrackIds.size() == 0 || (data.hiddenSeedTrackIds[0] is string && data.hiddenSeedTrackIds[0].size() <= 100))
        && data.hiddenSeedPhotoIds is list
        && data.hiddenSeedPhotoIds.size() <= 20
        && (data.hiddenSeedPhotoIds.size() == 0 || (data.hiddenSeedPhotoIds[0] is string && data.hiddenSeedPhotoIds[0].size() <= 100))
        && data.updatedAt is timestamp;
    }

    function isValidProfile(data) {
      return data.keys().hasAll([
          'ownerId', 'personalitySummary', 'musicalTasteSummary',
          'keyTraits', 'trackCount', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'personalitySummary', 'musicalTasteSummary',
          'keyTraits', 'trackCount', 'translations', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string
        && data.ownerId.size() > 0 && data.ownerId.size() <= 128
        && data.ownerId == request.auth.uid
        && data.personalitySummary is string
        && data.personalitySummary.size() >= 10 && data.personalitySummary.size() <= 1500
        && data.musicalTasteSummary is string
        && data.musicalTasteSummary.size() >= 10 && data.musicalTasteSummary.size() <= 1500
        && data.keyTraits is list
        && data.keyTraits.size() <= 6
        && (data.keyTraits.size() == 0 || (data.keyTraits[0] is string && data.keyTraits[0].size() <= 120))
        && data.trackCount is number
        && data.trackCount >= 0 && data.trackCount <= 5000
        && (!data.keys().hasAny(['translations']) || (data.translations is map && data.translations.size() <= 15))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidVisit(data) {
      return data.keys().hasAll([
          'countryCode', 'countryName', 'region', 'city', 'continent',
          'timezone', 'visitorLang', 'deviceType', 'referrerHost',
          'geoSource', 'dayKey', 'createdAt'
        ])
        && data.keys().hasOnly([
          'countryCode', 'countryName', 'region', 'city', 'continent',
          'timezone', 'visitorLang', 'deviceType', 'referrerHost',
          'geoSource', 'dayKey', 'createdAt'
        ])
        && data.countryCode is string
        && data.countryCode.size() >= 2 && data.countryCode.size() <= 3
        && data.countryCode.matches('^[A-Z]{2,3}$')
        && data.countryName is string
        && data.countryName.size() >= 1 && data.countryName.size() <= 80
        && data.region is string && data.region.size() <= 80
        && data.city is string && data.city.size() <= 80
        && data.continent is string && data.continent.size() <= 40
        && data.timezone is string && data.timezone.size() <= 80
        && data.visitorLang is string
        && data.visitorLang.size() >= 1 && data.visitorLang.size() <= 20
        && data.visitorLang.matches('^[a-zA-Z0-9_\\-]+$')
        && data.deviceType is string
        && data.deviceType in ['mobile', 'tablet', 'desktop']
        && data.referrerHost is string && data.referrerHost.size() <= 100
        && data.geoSource is string
        && data.geoSource in ['server-header', 'ip-geo', 'timezone']
        && data.dayKey is string
        && data.dayKey.size() == 10
        && data.dayKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.createdAt is timestamp;
    }

    match /test/connection {
      allow get: if true;
      allow list, write: if false;
    }

    match /tracks/{trackId} {
      allow get: if isValidId(trackId);
      allow list: if true;
      allow create: if isOwnerUser()
        && isValidId(trackId)
        && isValidTrack(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isOwnerUser()
        && isValidId(trackId)
        && isValidTrack(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'artist', 'country', 'countryCode',
          'language', 'languageCode', 'genre', 'isRemix', 'curatorNote', 'updatedAt'
        ]);
      allow delete: if isOwnerUser() && isValidId(trackId);
    }

    match /photos/{photoId} {
      allow get: if isValidId(photoId);
      allow list: if true;
      allow create: if isOwnerUser()
        && isValidId(photoId)
        && isValidPhoto(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isOwnerUser()
        && isValidId(photoId)
        && isValidPhoto(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'caption', 'order', 'updatedAt'
        ]);
      allow delete: if isOwnerUser() && isValidId(photoId);
    }

    match /siteConfig/{configId} {
      allow get: if configId == 'main';
      allow list: if false;
      allow create: if configId == 'main'
        && isOwnerUser()
        && isValidSiteConfig(incoming())
        && incoming().updatedAt == request.time;
      allow update: if configId == 'main'
        && isOwnerUser()
        && isValidSiteConfig(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'hiddenSeedTrackIds', 'hiddenSeedPhotoIds', 'updatedAt'
        ]);
      allow delete: if false;
    }

    match /profile/{profileId} {
      allow get: if profileId == 'main';
      allow list: if false;
      allow create: if profileId == 'main'
        && isOwnerUser()
        && isValidProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if profileId == 'main'
        && isOwnerUser()
        && isValidProfile(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'personalitySummary', 'musicalTasteSummary', 'keyTraits', 'trackCount', 'translations', 'updatedAt'
        ]);
      allow delete: if false;
    }

    match /visits/{visitId} {
      allow get: if isOwnerUser() && isValidId(visitId);
      allow list: if isOwnerUser();
      allow create: if isValidId(visitId)
        && isValidVisit(incoming())
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isOwnerUser() && isValidId(visitId);
    }
  }
}
