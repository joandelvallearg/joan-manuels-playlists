{
  "entities": {
    "Track": {
      "title": "Track",
      "description": "A curated YouTube music video with AI-detected country, singing language, and genre.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "description": "UID of the owner who added the track."
        },
        "youtubeId": {
          "type": "string",
          "minLength": 5,
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "YouTube 11-character video identifier."
        },
        "youtubeUrl": {
          "type": "string",
          "minLength": 10,
          "maxLength": 300,
          "description": "Original YouTube watch or share URL."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Song or music video title."
        },
        "artist": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150,
          "description": "Performer or artist name."
        },
        "country": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Country of origin detected by AI."
        },
        "countryCode": {
          "type": "string",
          "minLength": 2,
          "maxLength": 7,
          "pattern": "^[A-Z]{2,3}(,[A-Z]{2,3})?$",
          "description": "ISO 3166-1 alpha-2 country code (or two comma-separated codes for international remixes)."
        },
        "language": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Primary singing language(s) of the song."
        },
        "languageCode": {
          "type": "string",
          "minLength": 2,
          "maxLength": 22,
          "pattern": "^[a-zA-Z\\-]+(,[a-zA-Z\\-]+)?$",
          "description": "ISO 639-1 language code (or two comma-separated codes for bilingual remixes)."
        },
        "genre": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Musical genre."
        },
        "isRemix": {
          "type": "boolean",
          "description": "True when the track is a remix or bilingual/multi-country collaboration."
        },
        "curatorNote": {
          "type": "string",
          "maxLength": 400,
          "description": "Optional note from Joan Manuel about the track."
        },
        "thumbnailUrl": {
          "type": "string",
          "minLength": 10,
          "maxLength": 300,
          "description": "YouTube thumbnail URL."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "ownerId",
        "youtubeId",
        "youtubeUrl",
        "title",
        "artist",
        "country",
        "countryCode",
        "language",
        "languageCode",
        "genre",
        "thumbnailUrl",
        "createdAt",
        "updatedAt"
      ]
    },
    "Photo": {
      "title": "Photo",
      "description": "A personal photograph uploaded by Joan Manuel for the top header gallery.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "description": "UID of the owner who uploaded the photo."
        },
        "imageData": {
          "type": "string",
          "minLength": 10,
          "maxLength": 700000,
          "description": "Resized JPEG data URL or static path."
        },
        "caption": {
          "type": "string",
          "maxLength": 200,
          "description": "Optional caption for the photo."
        },
        "order": {
          "type": "number",
          "description": "Display order index."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "ownerId",
        "imageData",
        "caption",
        "order",
        "createdAt",
        "updatedAt"
      ]
    },
    "SiteConfig": {
      "title": "SiteConfig",
      "description": "Owner preferences controlling whether default showcase examples are hidden.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "description": "UID of the owner."
        },
        "hiddenSeedTrackIds": {
          "type": "array",
          "description": "IDs of default example tracks hidden by the owner."
        },
        "hiddenSeedPhotoIds": {
          "type": "array",
          "description": "IDs of default example photos hidden by the owner."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "ownerId",
        "hiddenSeedTrackIds",
        "hiddenSeedPhotoIds",
        "updatedAt"
      ]
    },
    "PsychologicalProfile": {
      "title": "PsychologicalProfile",
      "description": "AI-generated psychological and musical taste profile saved exclusively by Joan Manuel.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "description": "UID of the owner."
        },
        "personalitySummary": {
          "type": "string",
          "minLength": 10,
          "maxLength": 1500,
          "description": "Psychological portrait describing what kind of man Joan Manuel is based on his music."
        },
        "musicalTasteSummary": {
          "type": "string",
          "minLength": 10,
          "maxLength": 1500,
          "description": "Analysis of Joan Manuel's musical preferences, emotional sensitivity, and global tastes."
        },
        "keyTraits": {
          "type": "array",
          "description": "Up to 6 concise personality & taste traits derived from his playlist."
        },
        "trackCount": {
          "type": "number",
          "description": "Number of songs analyzed when saving this profile."
        },
        "translations": {
          "type": "object",
          "description": "Pre-translated profile summaries and key traits keyed by ISO 639-1 language code."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last-saved timestamp shown to visitors."
        }
      },
      "required": [
        "ownerId",
        "personalitySummary",
        "musicalTasteSummary",
        "keyTraits",
        "trackCount",
        "createdAt",
        "updatedAt"
      ]
    },
    "PageVisit": {
      "title": "PageVisit",
      "description": "Anonymous page visit event with coarse geographic metadata readable exclusively by Joan Manuel.",
      "type": "object",
      "properties": {
        "countryCode": {
          "type": "string",
          "minLength": 2,
          "maxLength": 3,
          "pattern": "^[A-Z]{2,3}$",
          "description": "ISO 3166-1 alpha-2 country code (or ZZ when unspecified)."
        },
        "countryName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Country name in Spanish."
        },
        "region": {
          "type": "string",
          "maxLength": 80,
          "description": "State, province, or region name if available."
        },
        "city": {
          "type": "string",
          "maxLength": 80,
          "description": "City name if available."
        },
        "continent": {
          "type": "string",
          "maxLength": 40,
          "description": "Continent or world region."
        },
        "timezone": {
          "type": "string",
          "maxLength": 80,
          "description": "IANA timezone reported by the visitor browser."
        },
        "visitorLang": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Visitor browser language code."
        },
        "deviceType": {
          "type": "string",
          "enum": ["mobile", "tablet", "desktop"],
          "description": "Coarse device category."
        },
        "referrerHost": {
          "type": "string",
          "maxLength": 100,
          "description": "Referring hostname or 'direct'."
        },
        "geoSource": {
          "type": "string",
          "enum": ["server-header", "ip-geo", "timezone"],
          "description": "How coarse geographic location was resolved."
        },
        "dayKey": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "UTC/local calendar day key (YYYY-MM-DD)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        }
      },
      "required": [
        "countryCode",
        "countryName",
        "region",
        "city",
        "continent",
        "timezone",
        "visitorLang",
        "deviceType",
        "referrerHost",
        "geoSource",
        "dayKey",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/tracks/{trackId}": {
      "schema": {
        "$ref": "#/entities/Track"
      },
      "description": "Publicly readable music tracks curated exclusively by Joan Manuel."
    },
    "/photos/{photoId}": {
      "schema": {
        "$ref": "#/entities/Photo"
      },
      "description": "Publicly readable top gallery photos uploaded exclusively by Joan Manuel."
    },
    "/siteConfig/{configId}": {
      "schema": {
        "$ref": "#/entities/SiteConfig"
      },
      "description": "Owner preferences document (main) controlling visibility of default showcase items."
    },
    "/profile/{profileId}": {
      "schema": {
        "$ref": "#/entities/PsychologicalProfile"
      },
      "description": "Publicly readable psychological and musical taste profile (main) generated and saved exclusively by Joan Manuel."
    },
    "/visits/{visitId}": {
      "schema": {
        "$ref": "#/entities/PageVisit"
      },
      "description": "Append-only anonymous page visit events with coarse geography, readable and deletable exclusively by Joan Manuel."
    }
  }
}
